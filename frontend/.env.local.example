NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_SEPOLIA_RPC=
NEXT_PUBLIC_BINANCE_DEMO_API_KEY=

# Supabase. The service-role key is server-only and must never be exposed with
# a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_COPY_TRADING_ADDRESS=

# Browser-readable contract address for read-only TradeHistory calls.
# The backend writer private key must never be exposed to the frontend.
NEXT_PUBLIC_TRADE_HISTORY_CONTRACT_ADDRESS=
NEXT_PUBLIC_TRADE_HISTORY_DEPLOYMENT_BLOCK=11306343

# Browser-readable contract address for read-only MasterTraderRegistry calls.
NEXT_PUBLIC_MASTER_REGISTRY_CONTRACT_ADDRESS=
NEXT_PUBLIC_MASTER_REGISTRY_DEPLOYMENT_BLOCK=11410856

# Server-only Sepolia writer settings used by Next API routes.
# Do not prefix BACKEND_WALLET_PRIVATE_KEY with NEXT_PUBLIC.
TRADE_HISTORY_CONTRACT_ADDRESS=
BACKEND_WALLET_PRIVATE_KEY=
RPC_URL=
CHAIN_ID=11155111

# Server-only Verified Master Trader registry settings.
MASTER_REGISTRY_CONTRACT_ADDRESS=
MASTER_VERIFIER_PRIVATE_KEY=
MASTER_REGISTRY_DEPLOYMENT_BLOCK=11410856

# Server-only copy-trading executor settings.
COPY_TRADING_CONTRACT_ADDRESS=
COPY_TRADING_EXECUTOR_PRIVATE_KEY=
COPY_TRADING_DEPLOY_BLOCK=0
